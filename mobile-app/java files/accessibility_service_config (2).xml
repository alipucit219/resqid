<?xml version="1.0" encoding="utf-8"?>
<!--
    Place this file at:
    android/app/src/main/res/xml/accessibility_service_config.xml
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"

    <!--
        FLAG_REQUEST_FILTER_KEY_EVENTS is the critical flag —
        it allows the service to intercept hardware key events
        including the power button (KEYCODE_POWER)
    -->
    android:accessibilityFlags="flagRequestFilterKeyEvents"

    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"

    <!--
        Setting this to "" means the service runs even when
        no specific app is in the foreground — system-wide
    -->
    android:packageNames="" />
