{
  "info": {
    "_postman_id": "8d9b3dcb-6ad9-4d3e-8e98-5bb3632da9c6",
    "name": "RESQID Auth + SOS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.accessToken) {",
              "  pm.collectionVariables.set('token', json.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v2",
            "auth",
            "login"
          ]
        },
        "description": "Logs in a user and stores the returned accessToken into the collection variable `token`."
      },
      "response": []
    },
    {
      "name": "Send SOS Alert",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"latitude\": 24.8607,\n  \"longitude\": 67.0011,\n  \"message\": \"Help needed immediately\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/me/panic-alerts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v2",
            "me",
            "panic-alerts"
          ]
        },
        "description": "Triggers a panic/SOS alert for the authenticated user."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://192.168.100.245:8000"
    },
    {
      "key": "email",
      "value": "user@example.com"
    },
    {
      "key": "password",
      "value": "YourPassword123"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
